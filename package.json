{
  "name": "dead-sector",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Direct-source browser build of DEAD SECTOR",
  "scripts": {
    "check": "npm run check:syntax && npm run test",
    "check:syntax": "node scripts/check-syntax.mjs",
    "dev": "node scripts/serve.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
